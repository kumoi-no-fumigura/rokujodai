 ],
 "poems": [
  {
   "seq": "1",
   "text": "あしびきの山松の上比朝づく日霞みそめさり春やたつらむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ふる年あかはる色とも見えなくに今朝い野山の珍しきかな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "さヾ波の比良の高嶺の玄ら雪い春のいつまで殘るなるらむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "けふこそと出て來つれと春の野の若菜n未ど少なかりけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春日野の飛火の野邊に打むれて若菜つむらむ人のそで見ゆ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春いけふ限とおもへバ鶯のこゝらなくねもさびしかりけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "はるすぎて夏やきぬらむ爲いみやまの里あかへりてぞなく",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "山河〓いはにせかれてたつ波をきし比卯花ちるかとぞ見る",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "足引のやま時鳥さみどれのふるをやなれもわびてなくらむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "ひさかされ空ふく風も薫りけり菖蒲をふかぬ家しなけれバ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "とこなつの花の盛ふなるまゝに照日いあつくなり增りけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "墨比江比きしの松原きりはれてさやかふすめる秋比よの月",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "山のはの月まち出て凉しくもなりぬと思へバ夜い明あけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あしびきの山田色づく秋されバ照日の影もろおしろぎりま",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ひさかさの天つ御空の果もなきわが思こそかなしかりけれ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "徒にくれゆくとしと思ひしい我身おつもるよはひなりけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "み佛〓み名ふてきえぬ罪あらバいかおかもせむ我後比世を",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "朝戶あけてけさ見渡せバ白妙の雪にこもらぬ山なかりけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "曉比そらにすみてもきこゆなり大宮びとのほしうたふこゑ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "雪ふりてこもる頃よりさぶきかな霜かきわさを小山田の里",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "かつらざや高まの峯おゐる雲の玄ぐれて渡る冬いきあけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "よも山北木々の梢をそめつくし今いと秋のくれてゆくらむ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "なが月の時雨北あめお松の葉比ときは比山も色づきおけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "きりはら比駒いひけども逢坂の關路の月いくもらざりけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "うちよする波の音おもちりおけり野島がさきの秋萩のはな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "我宿にあすこむ秋をこよひより音みぞたつるをぎの上かぜ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "神無月たちにし日よりひら山の時雨の雲いはなれざりけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "夕闇のそらにごりして浮雲のひまより光るいなづまのかげ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "大ひえのをびえの山のあなさより神なり出て雲ぞたちくる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "我上比みるうちつけにかなしきい鳥部の山比けぶりんけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "浮雲のたえまに白く見えにけり比良比高嶺のけさのはつ雪",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "山ざとい秋のうちよりおく霜ゐはぎも薄もかれはておけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "松のは比雫比おちてそむれバや下はふつさも色にいづらむ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "わが宿の荻の枯葉になりしより時雨の雨のふらぬ日ぞなき",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "から衣たつたの里あふゆきぬともみぢ散らして嵐ふくなり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "我岡北あずゑ比紅葉こきちらしけさはさかろす山颪のかぜ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "片岡のかきねの柳なびくめりいと比どかおも風やふくらむ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "ほがらかに夜いあけされど有明比月ハ樹間に猶ぞさやけき",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "もみぞめの夕べの空のうも雲のうちにほのめく三日月の影",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "わが宿の池い氷にとぢはてヽ月もやどらずなりおけるかな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "花山いはるたけぬれと雲雀さつ野邊い菫此さかりなりけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "此まゝにくちなむ我いむち時雨ふる比山田のそほづえけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "山田もるかりほの庵お朝な〓〓きてもなく哉いなおほせ鳥",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "あしびきの山田が原のかり庵の時雨にあるゝ冬いきおけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "卯花のさかりもいまだすぎなくに岡田比里いさ苗とるなり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "さくら花ちりてさびしくなるなべに苗代つくる小山田の里",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "かゞみ山夕日のかげあなるまゝに麓北うまやけぶり棚びく",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "敷島のやまと大路いよるさへにゆきゝの人の絶る間ぞおき",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "時ゑらぬ常磐の森の陰玄めてすむらむ人ぞ千代いへぬべき",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "遠山比みねゑろさへお雪ふりてすみやく烟あらはれふけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "斧のえのくちし物ゆゑもろこしのそ北山人の名い殘りりま",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "夕月北かげ山の井ふ見えそめて紅葉の色いくれわゝりけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "山里いさぶき頃ふもなりおけりあした霜おき夕べ玄ぐれて",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "粟田山もみづる頃になりしよりよひノ〓鹿のこゑぞ聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "山鳥のみねをへだてゝひとりぬる契に似たるわがちぎり哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "たらちね〓親の惠おくらぶれバ千尋比海もあさしとぞきく",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "ます鏡とりてし見れバ我ながら耻かしきまでとし老おけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "あけされバ明さるまゝに捨置けバ柴比編戶いあるかひもなし",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "わきかへる逢坂山のはしり井の水のそこふも宿るつきかな",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "うき事代聞にぬ里も廣き世おなからましやい尋ねても見む",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "大君の千代おまします百敷のみやこにすむが樂しかりけり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "都鳥なくこゑきゝて浪花江はうきね悲しくなりおけるかな",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "夕日かげさすや岡田の畦づさひ小鷹をすゑて人比ゆく見ゆ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "いかならむ鳥あああらむ名ふおへる鷲比み山いみ佛のやま",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "春日野比飛火の野邊を來て見れバ庵も見えきもる人もなし",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "住の江比遠里を野比からはぎに小鳥ゑばなく聲のさびしさ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "八千草のはなの盛の此野邊いひるもふりいでて鈴虫ぞなく",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "俄あもふる夕だちにあひおけり夏野を苅りに出てきされが",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "ちる花弦手向ふしてもあえゆかむ逢坂山のもりのゑさみち",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "千早振かみの御前にぬさとりていのる祈いきみが世のさめ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "かへりこむ程を定めぬ旅なれがけふ比別ぞかぎりならまし",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "行末のきみが千年ああはむとて我身のうへも祝ふ今日かな",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "わがうへにおもひかへして唐衣ひとに恨いかけじとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "音おのみきゝおし人のいかなれバ面影たちて戀しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "沖つべになみの白花さきふけり汐さゐ荒くなりや玄ぬらむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "さ夜ふけて沖つ嵐やさえぬらむ浦かさつきて千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "磯およる波のまに〓〓なびく藻の亂れぬ日なきわが心かな",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "沖つべに碇おろして志ほまてバ波のそこより月ぞにほへる",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "わたつみの大海原のはてもなき沖をこぎても渡る今日かな",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "山川の波比うたかさ消えぬまを賴む我世ぞはかなかりける",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "ふるほどの雨い殘らず我宿のにはたづみともなりおける哉",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "あしねてふ入江の沼のうきおのみ沈みはてなむ我身悲しも",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "山川のやなにかゝりて落鮎のひれふる見るがあはれんけり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "う船さもくらはし川の篝火い水おうつりてもえまさりタり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "山かげの筧にかよふ水のおとい明暮きけどさびしかりりと",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "あらし山はなの光もくれゆけバとなせれおくに蛙なくなり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "音さへにもみとほりても流るゝい吉野のふくのきさ川の水",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "田上のやまがは遠く篝火のもゆるぞ見ゆるひをやよるらむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "若鮎〓のぼる頃ふもなるなべに花ちりわさるみよし野の里",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "このゆふべ堅田の浦にほのめくい鮒とるふねの篝なるらむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "萬代のかめの齡おともなふいこのやま川のいはほなりけり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "池水比そこをくヾりて鳰どりい思はぬかさにうき出みりま",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "けさ見れバ池の汀にゐるかも比靑羽も玄ろく霜ふりふけり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "花をのみかざりたてたる昨日おいかはる姿のあはれなる哉",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "墨ぞめに衣いそめて着されどもうきい姿によらぬなりけり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "くさ枕たびゆく路いのる駒のつまづくごとお妹ぞこひしき",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "古里いおもひやるだお遠きかな幾重の山をこえてきつらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "鳥邊野の烟となりてたちのぼる人比はでこそ悲しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "山川のいはねバゑらじ白波のうちいでて見む底のこゝろを",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "へだてなくなりて思へバ君とわぶ下の心いひとつなりけり",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "白波比おもひよもれどかひなきい人れ心のいはねおとりま",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "いかおせむ我をパおきて白雲のよそにうつろふひとの心を",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "秋の野の千草が中にをみなへし一本わきてあはれとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "吳竹のよをうきものに思ひしい君とすまはぬむかしえけり",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "閨比戶に有明の月のかげさしてつらき時にもなりおける哉",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "今よりい一夜もかれぞ君またむ獨いいこそねられざりりれ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "玉鉾のみち遠けれバ鳥比あと通はもゞふも日をぞへにける",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "君こむと松の板戶をあけおきて詠めしをれバ月ぞさしくる",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "またぬ夜夜君いこむとやかくばかりまつ夜每あいつれなかるらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "初雁のなくねい妹がよぶ聲うきくうちつけふ戀しかりけり",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "あさがほの花の上なる露のまもきみを心おおかぬまぞなき",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "めづらしき妹が袂をふきかへしすみれさく野に春風ぞふく",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "此朝け雨亥とヾにも降なゝむ晴るゝまつとて君やとまらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "おもひ川思ひの淵に沈むとも戀すてふ名いたてじとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "我戀いゑほやく海人のふる衣なれてかふくもなりにける哉",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "なつ衣たもと涼しくたちかへて花の名殘い今朝わもれりり",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "秋かぜの衣手さぶくふくなべに庭れま萩いみざれてぞちる",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "聲すみて月のあたりに聞ゆなり棚機つめやころもうつらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "妹がひくももその色北紅にさきてにほへるいはつゝじかな",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "よの中のひと比心い言のはの上にてのみいたおまれなくに",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "今宵ひく琴のゑらべになき人の聲こもればや悲しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "武士いさつ矢たばさみ刀さし片野のみ野をかりにゆくらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "武士の刀もさやにをさまりし君グ御代あそたのしありけれ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "積りぬる我物思ひいはかりなし何にかけでう數を玄らまし",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "やましろの常磐の山の松のはの色おや君が千代い見ゆらむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "磯菜とるを島のあまのぬれ衣を君がさめおも我い着ふけり",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "にごりぬに生ふる蓮のいかなれバ殊おも〓き花のさくらむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "この菴比垣ほにたちて匂へるい薄むらさきの志をにんけり",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "此山の柴ぐりうさむいざや子ら登りしくれバましらなくん",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "いさぎよき色おさきても匂ふめまかさ柴垣のきちかうの花",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "秋の野をわけつゝくれパ草のかう袖に移りて匂ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "みちのくの三浦グ崎のねつこ草ねによる浪の我おもひかい",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "くさ枕たびゆく道のたむけ草あるにまかせて萩がはなをる",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "もゝよ草あふ夜の數北名なりとい我庭もせに植ておかまし",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "にこ草の花にこやかに匂ふめる川べづさひに此日くらせり",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "常磐木の森にも秋やこもるらむかげなる草い花づきにりま",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "冬きぬとけさおく霜にわが宿の尾花が袖いうつろひにけり",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "ふく風のみおしむ頃になりにけり野邊の秋萩今かさくらむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "水鳥比かもの川原にひきはへてさらも此布たれりおりけむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "嵐やまかどゆく水の玄ふあやい花をうつして波ぞかりける",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "紅にみむろの山をそめてけりいかにふりたる時雨なるらむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "あ比夕ベ軒端にさがるさゝがにい誰こむとての驗なるらむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "艸むふに螢れかげの見えそめてをぐらくなりぬ岡のべの道",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "夕月のかげになるまでかた岡のまつの梢にひぐらしぞなく",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "いづちにもゆきてなかなむ葢なが聲きけがものぞかなしき",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "つくま川いり江のみくりくり返し同じ事のミ思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "物おもひのみも積りて片ばみのいつまで難き逢瀬なるらむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "神やまの峯の葵も兼てより今日にあはむとおひやゑおけむ",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "つの國H有馬が嶽比之らすげの根深きおもひ人玄るらめや",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "嵐やま花のさかりに〓け入りてひかげかづらし遊びける哉",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "夏くさ比玄げみが下にたれこひて色にもゆらむ姫百合の花",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "白河比きよき根芹をつまむとておとさつ袖に波ぞかゝれる",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "おのが世い事なし草の事なしにけふの一日も暮おけるかな",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "虫のねの晝もたゆまぬ數かげい月草のはなさかりなりけり",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "山里のかきねづさひにゆく水の淀めるかさに菱おひふらり",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "萩が花玄をりれきつゝ此野べの末はるかにも誰りゆきけむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "秋ふかくなりてもうもきさほ山の柞の色いまがはざりけり",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "時之らぬ松にならひてかへの葉もふか綠ふやれひ茂るらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "我妹子が垣根おさける花ざくらことにも色のなつかしき哉",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "片岡のはやしがくれに夕日かげ殘ると見れバひざくらの花",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "君まちてありつる程に我宿のあへたち花いみもおちおけり",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "梅雨のふりしく時になりにけり庭のざくろの花もさきつゝ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "からもゝの花のあとにぞ三千年比齡比ばゆる實い結ぶらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "むろの木を蚊遣み爲にふもぶらし烟にほへる大はら比さと",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "朝日影さしわたれども山陰のねぶの葉いまだねぶげなる哉",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "あしびきの山下道のほゝがしはうれ葉靡けて朝かぜぞふく",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "こがひする時やきぬらむ山陰の桑の葉とりに少女つどへる",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "足引此みやまの里のはさつもりつもりてつきぬわが思あな",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "あさな〓〓〓きみグ原におく露を玉にもかくる墨染のそで",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "あさけより霞こめてもふる雨おあせみの花い色あせにけり",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "ましらなく檜原が奧のかくれがの庭にさきさり山ちさの花",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "末とほき齡をきみおゆづるはの綠ふかくも玄ゆりぬるかな",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "人玄れぬ垣根がくれのかたかごの片戀ばかり苦しきいなし",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "庵玄めて我すみわさる谷かげの巖がうへにつまゝおひさり",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "柴の戶にさねき北花い咲ぬれど人しとはねが見る人もなし",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "はなち鳥雲ゐ遙おたちのぼりいかに嬉しきねをバなくらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "すみの江の松の梢あひな鳥のなく聲すなり餌をやまつらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "巢ごもりのたづがね悲しさ夜ふけて松の梢ふ霜やおくらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "春たちて浪の上露むわさつみの沖べにたづの聲ぞきこゆる",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "五月雨のあめ比ふりいでて時鳥わが山里にをちかへりなく",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "さよふけて鴉なくなり山松のねぐらあらはに月やすむらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "木枯にもみぢ殘らずちりはでゝさびしき宿に鵙ぞなくなる",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "はこ鳥の聲あけおさに聞ゆなりわが岡のべの松おなくらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "朝日かげさしにほひたる山松のこのま比花にかほ鳥ぞなく",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "つばくらめ來てなく頃になりおけり山の櫻や匂ひそむらむ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "君が爲千代のかざしに折りていなむ山路おさける白菊の花",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "小車の牛おもなるときくからにかなしくもあるか墨染の袖",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "玉ざれのをすの內こそゆかしけれさしても思ふ人いなけれど",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "鈴鹿山さかの玄さにも宿りして散ふる夜をわびあかすかな",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "天地のあらむ限いうち日さを君がみやこもさかゆべらなり",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "小倉山みねのもみぢ葉秋ごとに君がみゆさやまち渡るらむ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "年をへてあはぬのみかい玉梓の使もいまいこぞなりおけり",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "斧のおと今い聞えずなりふけりみほの柚山あれやゑぬらむ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "狩人おおはれてなくケむさゝびの聲高まとの野べに聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "から國のあら野が原にすむ虎い名をきくだにも恐ろしき哉",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "奧山ふすむあら熊もまことある物としきけがなつかしき哉",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "すくも火の上おハ見えず下ふのみもえ渡るかな我物おもび",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "一年のをはりにみそか加はりて春まちどほお思ほゆるかな",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "たなばさの又の逢夜の遠けれが今朝の別やくるしかるらむ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "かも山比あふひをとりて百敷北大宮びとのかざす今日かな",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "君が代の春のためしにひかれでも玉しく庭にいづるあ残馬",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "のる駒のひづめよかなて鈴鹿山ちりたる花を又ちらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "長閑ふるあらしの山の夕づく夜何よみだれて花いちるらむ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "さら〓〓と流れおちてもゆく水よ心のとまる夏い來よけり",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "志き瓦われしひまよりおひいでてさやぐ砌のをぎのうは風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "ま萩さく野道ハゆかじわけゆかパ露や乱れむ花やちりふむ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "207",
   "text": "とりとめて何をそれとハふけれども涙ぐまるゝ秋の夕ぐれ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "208",
   "text": "粟田山をのへお秋やこもるらむ見るうちつけお物ぞ悲しき",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "209",
   "text": "あはれ又こよひの秋よあひよけり思ヘバ月も老やしぬらむ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "210",
   "text": "いつの世よかへり來て見む中山のふもとの里の秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "211",
   "text": "戸たづの千年や御手よいりつらむとよミ渡れる御狩野の原",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "212",
   "text": "目の前よありてふき世を示すうる炎も法のほうよやいある",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  }
 ],
